# Copy to backend/.env (the backend also reads ../.env.local if you keep keys there).

# Required for real AI (get one at https://aistudio.google.com/apikey).
# Without it the app runs in MOCK MODE with placeholder conversations (UI work only).
GEMINI_API_KEY=

# Optional. Defaults to the "gemini-flash-latest" alias. Pin a specific model from AI Studio if you prefer.
# GEMINI_MODEL=gemini-flash-latest

# Optional: minimal (default, fastest) | low | off
# GEMINI_THINKING=minimal

# Optional: total messages per agent date (default 10 = 5 each)
# DATE_TURNS=10

# Optional with a single server process (data lives in memory, lost on restart).
# Required if you run several workers/instances: free Upstash Redis (or the KV_REST_API_* equivalents).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: comma-separated origins allowed to call the API directly (not needed when proxied via Next.js).
# CORS_ORIGINS=https://your-frontend.vercel.app
