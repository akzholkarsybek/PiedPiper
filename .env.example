# Frontend (Next.js). All AI / storage settings live in backend/.env (see backend/.env.example).

# Local `npm run dev` only: where the separately started Python backend runs; Next.js proxies /api/* to it.
# Not used on Vercel or under `vercel dev` (vercel.json routes /api/* to the backend service directly).
API_URL=http://127.0.0.1:8000
